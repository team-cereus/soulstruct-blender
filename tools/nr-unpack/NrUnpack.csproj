<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unpacks selected folders from a Nightreign install for Stan's Tools. Built on Smithbox's Andre.IO (MIT, Vawser);
       see README.md. Pass -p:SmithboxDir=<clone> if Smithbox is not at S:\Smithbox. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NrUnpack</AssemblyName>
    <Version>1.2.0</Version>
    <SmithboxDir Condition="'$(SmithboxDir)' == ''">S:\Smithbox</SmithboxDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SmithboxDir)\src\Andre\Andre.IO\Andre.IO.csproj" />
    <EmbeddedResource Include="$(SmithboxDir)\src\Andre\Andre.Formats\Resources\EldenRingNightreignDictionary.txt"
                      LogicalName="EldenRingNightreignDictionary.txt" />
  </ItemGroup>

  <!-- Layouts of the params Stan's Tools reads. An embedded def is what selects a param for export. -->
  <ItemGroup>
    <ParamName Include="NpcParam;EquipParamWeapon;EquipParamProtector;WepAbsorpPosParam" />
    <ParamName Include="SmallBaseAndSpotAttachPoint;SmallBaseAndSpotDefine;SmallBaseMapVariationParam" />
    <ParamName Include="LotResultMapPatternFlag;LotResultPlayAreaParam;LotResultSmallBaseAndSpot" />
    <EmbeddedResource Include="@(ParamName->'$(SmithboxDir)/src/Smithbox.Data/Assets/PARAM/NR/Defs/%(Identity).xml')">
      <LogicalName>ParamDefs.%(Filename).xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
